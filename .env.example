# Copy to .env and adjust. Mistbox needs no secrets in the environment:
# the admin account is created interactively and API keys are generated in the UI.

# Published address. Keep 127.0.0.1 and use an HTTPS reverse proxy for remote access.
MISTBOX_HOST=127.0.0.1
MISTBOX_PORT=8725

# Session cookie `Secure` flag. Keep true (works on https:// and http://localhost).
# Only set false for plain-HTTP testing on a LAN address.
MISTBOX_COOKIE_SECURE=true
MISTBOX_SESSION_TTL_HOURS=12

# Limits
MISTBOX_MAX_UPLOAD_BYTES=10737418240      # 10 GiB per file
MISTBOX_PREVIEW_MAX_BYTES=2097152         # 2 MiB of text decoded for preview
MISTBOX_LATEX_MAX_INPUT_BYTES=52428800    # 50 MiB of .tex + images per compile

# Days before items in the recycle bin are deleted permanently (0 = never).
MISTBOX_TRASH_DAYS=30

# Semantic search (local embedding model, baked into the image at build time).
# multilingual-e5-small-q8 (default, int8, ~120 MB) | multilingual-e5-small | multilingual-e5-base
# | bge-small-zh | paraphrase-multilingual-minilm | off
# Changing the model requires `docker compose build`; the index is rebuilt automatically.
# Docker uses Microsoft's portable CPU runtime, including on x86 CPUs without AVX2.
MISTBOX_RAG_MODEL=multilingual-e5-small-q8
MISTBOX_RAG_MAX_FILE_BYTES=1048576        # text files larger than this are not indexed
MISTBOX_RAG_MAX_PDF_BYTES=33554432        # PDFs larger than this are not indexed (32 MiB)
MISTBOX_RAG_THREADS=2                     # CPU threads for embedding
MISTBOX_RAG_IDLE_UNLOAD_SECS=300          # unload the model after 5 idle minutes (0 = keep loaded)

# Code embedding model for the diagnose / optimise mode ("similar code" search).
# jina-code-q8 (default, int8, ~160 MB file, ~225 MB RAM while loaded, unloaded
# when idle like the text model) | off. Needs MISTBOX_RAG_MODEL != off (embed build).
# Changing it requires `docker compose build`.
MISTBOX_CODE_MODEL=jina-code-q8

# Set true only when a trusted reverse proxy sets X-Forwarded-For (rate limiting per client).
MISTBOX_TRUST_PROXY=false
MISTBOX_LOGIN_ATTEMPTS=10                 # per IP per 15 min
MISTBOX_API_RATE_PER_MIN=1200

# LaTeX worker resource limits
LATEX_TIMEOUT_SECS=60
LATEX_CPU_SECS=45
LATEX_MEMORY_MB=1536
LATEX_MAX_OUTPUT_MB=50
LATEX_CONCURRENCY=2

RUST_LOG=info,sqlx=warn

# Network used by RUN steps during `docker compose build`. Set to "host" if the
# host's DNS is only reachable from the host itself (e.g. Tailscale MagicDNS 100.100.100.100).
MISTBOX_BUILD_NETWORK=default
